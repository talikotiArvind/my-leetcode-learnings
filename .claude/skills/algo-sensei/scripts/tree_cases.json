{
  "Trees/Max depth of binary tree/py_code.py": {
    "method": "maxDepth",
    "output_type": "value",
    "cases": [
      { "args": [{ "type": "tree", "value": [3, 9, 20, null, null, 15, 7] }], "expected": 3 },
      { "args": [{ "type": "tree", "value": [] }], "expected": 0 },
      { "args": [{ "type": "tree", "value": [1] }], "expected": 1 },
      { "args": [{ "type": "tree", "value": [1, null, 2] }], "expected": 2 }
    ]
  },
  "Trees/Invert Binary Tree/py_code.py": {
    "method": "invertTree",
    "output_type": "tree",
    "cases": [
      { "args": [{ "type": "tree", "value": [4, 2, 7, 1, 3, 6, 9] }], "expected": [4, 7, 2, 9, 6, 3, 1] },
      { "args": [{ "type": "tree", "value": [2, 1, 3] }], "expected": [2, 3, 1] },
      { "args": [{ "type": "tree", "value": [] }], "expected": [] }
    ]
  },
  "Trees/Same Tree/py_code.py": {
    "method": "isSameTree",
    "output_type": "value",
    "cases": [
      { "args": [{ "type": "tree", "value": [1, 2, 3] }, { "type": "tree", "value": [1, 2, 3] }], "expected": true },
      { "args": [{ "type": "tree", "value": [1, 2] }, { "type": "tree", "value": [1, null, 2] }], "expected": false },
      { "args": [{ "type": "tree", "value": [1, 2, 1] }, { "type": "tree", "value": [1, 1, 2] }], "expected": false }
    ]
  },
  "Trees/Diameter of binary tree/py_code.py": {
    "method": "diameterOfBinaryTree",
    "output_type": "value",
    "cases": [
      { "args": [{ "type": "tree", "value": [1, 2, 3, 4, 5] }], "expected": 3 },
      { "args": [{ "type": "tree", "value": [1, 2] }], "expected": 1 },
      { "args": [{ "type": "tree", "value": [1] }], "expected": 0 }
    ]
  },
  "Trees/Path Sum/py_code.py": {
    "method": "hasPathSum",
    "output_type": "value",
    "cases": [
      { "args": [{ "type": "tree", "value": [5, 4, 8, 11, null, 13, 4, 7, 2, null, null, null, 1] }, { "type": "value", "value": 22 }], "expected": true },
      { "args": [{ "type": "tree", "value": [1, 2, 3] }, { "type": "value", "value": 5 }], "expected": false },
      { "args": [{ "type": "tree", "value": [] }, { "type": "value", "value": 0 }], "expected": false },
      { "args": [{ "type": "tree", "value": [1, 2] }, { "type": "value", "value": 1 }], "expected": false }
    ]
  }
}
